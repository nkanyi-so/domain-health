# Copy to .env and fill in. .env is ignored by git and never read by the agent.
# Nothing here is needed for `make check`, `make eval` or `make dev`.

# --- The build (this machine only; never set in Cloud Run or Vercel) ---

# OpenAI key for `make eval-live` and `make record`. From a project with a $10 monthly budget.
OPENAI_API_KEY=

# The Google Cloud project `make infra`, `make deploy-backend` and `make seed` write to,
# always through the gcloud configuration named below.
GCP_PROJECT_ID=
CLOUDSDK_ACTIVE_CONFIG_NAME=domain-health
GCP_REGION=us-central1

# --- The deployed service (Secret Manager on Cloud Run, environment variables on Vercel) ---

# The Cloud Run URL the frontend's server routes call.
BACKEND_URL=
# Shared by the frontend's server routes and the backend's /api/* routes.
PROXY_SECRET=
# Signs the visitor and admin session cookies.
SESSION_SECRET=
# The admin sign-in passphrase.
ADMIN_PASSPHRASE=
# Optional, not a secret (Vercel only). The repository's https address, for the page's "Source"
# links. Left unset, the links are left out.
REPO_URL=
# Optional. A Slack incoming-webhook URL for the change alert. Empty on the hosted demo.
SLACK_WEBHOOK_URL=
